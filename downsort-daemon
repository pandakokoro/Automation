import logging
import shutil
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from watchdog.events import FileSystemEventHandler
from watchdog.observers import Observer

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[logging.StreamHandler(sys.stdout)],
)

TARGET_DIR = (Path.home() / "Downloads").resolve()

# Mapping extension categories
EXT_MAP = {
    "Images": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg"],
    "Documents": [".pdf", ".docx", ".txt", ".xlsx", ".pptx", ".csv"],
    "Media": [".mp4", ".mp3", ".mkv", ".wav", ".mov", ".avi"],
    "Archives": [".zip", ".tar", ".gz", ".rar", ".7z", ".iso"],
    "Code": [".py", ".js", ".html", ".css", ".json", ".cpp", ".sh", ".sql"],
    "Executables": [".exe", ".msi", ".dmg", ".pkg", ".deb", ".appimage"],
}

# O(1) Lookup dict
LOOKUP = {ext.lower(): cat for cat, exts in EXT_MAP.items() for ext in exts}
CATEGORY_NAMES = set(EXT_MAP.keys()) | {"Others"}
TEMP_EXTENSIONS = {".tmp", ".crdownload", ".part", ".download", ".aria2"}


def resolve_unique_path(dest_dir: Path, target_name: str) -> Path:
    """Atomically resolves path collisions using an incremental counter."""
    dest_file = dest_dir / target_name
    if not dest_file.exists():
        return dest_file

    path_obj = Path(target_name)
    stem, suffix = path_obj.stem, path_obj.suffix
    counter = 1

    while True:
        candidate = dest_dir / f"{stem}_{counter}{suffix}"
        if not candidate.exists():
            return candidate
        counter += 1


def wait_until_ready(file_path: Path, timeout: float = 60.0, poll_interval: float = 0.5) -> bool:
    """
    Non-blocking check ensuring file writing is complete and locks are released.
    """
    start_time = time.monotonic()
    last_size = -1

    while time.monotonic() - start_time < timeout:
        if not file_path.exists():
            return False
        try:
            current_size = file_path.stat().st_size
            # Test if file lock is released
            with open(file_path, "rb"):
                pass

            # Check stability (allows 0-byte files if they remain steady across polls)
            if current_size == last_size:
                return True
            last_size = current_size
        except (PermissionError, OSError):
            pass

        time.sleep(poll_interval)
    return False


def process_file(file_path: Path):
    """Sorts a single file safely within a thread pool execution context."""
    try:
        file_path = file_path.resolve()

        # Sanity & Recursion Checks
        if not file_path.exists() or file_path.is_dir() or file_path.name.startswith("."):
            return
        if file_path.parent.name in CATEGORY_NAMES:
            return
        if file_path.suffix.lower() in TEMP_EXTENSIONS:
            return

        # Ensure file isn't busy being written to
        if not wait_until_ready(file_path):
            logging.warning(
                f"Skipped '{file_path.name}': File lock timeout or removed during write."
            )
            return

        ext = file_path.suffix.lower()
        category = LOOKUP.get(ext, "Others")
        category_dir = TARGET_DIR / category
        category_dir.mkdir(parents=True, exist_ok=True)

        dest_path = resolve_unique_path(category_dir, file_path.name)
        shutil.move(str(file_path), str(dest_path))

        logging.info(f"Successfully moved '{file_path.name}' ➡️  {category}/{dest_path.name}")

    except FileNotFoundError:
        pass
    except PermissionError as e:
        logging.error(f"Permission denied while moving '{file_path.name}': {e}")
    except Exception as e:
        logging.error(f"Unexpected error processing '{file_path.name}': {e}", exc_info=True)


class ThreadedDownloadHandler(FileSystemEventHandler):
    def __init__(self, executor: ThreadPoolExecutor):
        super().__init__()
        self.executor = executor

    def on_created(self, event):
        if not event.is_directory:
            self.executor.submit(process_file, Path(event.src_path))

    def on_moved(self, event):
        if not event.is_directory:
            self.executor.submit(process_file, Path(event.dest_path))


if __name__ == "__main__":
    logging.info(f"👁️ Daemon Started: Monitoring {TARGET_DIR}")

    with ThreadPoolExecutor(max_workers=4) as executor:
        event_handler = ThreadedDownloadHandler(executor)
        observer = Observer()
        observer.schedule(event_handler, str(TARGET_DIR), recursive=False)
        observer.start()

        try:
            while True:
                time.sleep(1)
        except KeyboardInterrupt:
            logging.info("Stopping daemon...")
            observer.stop()
        observer.join()

    logging.info("🛑 Daemon stopped cleanly.")
